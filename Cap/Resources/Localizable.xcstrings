      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https://example.com/upload"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "https://example.com/upload"
          }
        }
