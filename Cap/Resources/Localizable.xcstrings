      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload Failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳失敗"
          }
        }
      }
