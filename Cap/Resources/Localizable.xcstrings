{
  "sourceLanguage": "zh-Hans",
  "strings": {
    " · 已上传": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Uploaded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " · 已上傳"
          }
        }
      }
    },
    " · 已标注": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Annotated"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " · 已標註"
          }
        }
      }
    },
    "%@\n%lld×%lld px\n单击复制，右键查看更多操作": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%lld×%lld px\nClick to copy, right-click for more"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%lld×%lld px\n按一下複製，右鍵查看更多操作"
          }
        }
      }
    },
    "Cap · %@ 截图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap · %@ Capture"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap · %@ 截圖"
          }
        }
      }
    },
    "Cap · 缺少屏幕录制权限，点击查看": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap · Missing screen recording permission, click for details"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap · 缺少螢幕錄製權限，點擊查看"
          }
        }
      }
    },
    "Cap 历史": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap History"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap 歷史"
          }
        }
      }
    },
    "Cap 没有屏幕录制权限。请在系统设置中授权后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap doesn't have screen recording permission. Grant it in System Settings and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap 沒有螢幕錄製權限。請在系統設定中授權後重試。"
          }
        }
      }
    },
    "Cap 需要「屏幕录制」权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap needs “Screen Recording” permission"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap 需要「螢幕錄製」權限"
          }
        }
      }
    },
    "Cap 需要屏幕录制权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap needs screen recording permission"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap 需要螢幕錄製權限"
          }
        }
      }
    },
    "JPEG（质量 0.85）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG (quality 0.85)"
