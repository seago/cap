    },
    "上传成功后链接自动复制到剪贴板": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is copied to the clipboard after upload"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳成功後連結會自動複製到剪貼板"
